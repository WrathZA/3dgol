{
	"name": "3dgol",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Conway's Game of Life with the time axis drawn — each generation stacked as a layer.",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"smoke": "node e2e/smoke.mjs",
		"og-image": "node e2e/og-capture.mjs",
		"format": "biome check --write",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"@types/three": "^0.185.1",
		"playwright": "^1.62.0",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd"
		]
	},
	"dependencies": {
		"three": "^0.185.1"
	}
}
